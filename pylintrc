[MAIN]
jobs = 1

[BASIC]
no-docstring-rgx = ^(_|test)
method-rgx = (([a-z_][a-z0-9_]{2,40})|(OpenKey|QueryValueEx|SetValueEx))
const-rgx = (([A-Z_][A-Z0-9_]*)|(__.*__)|winreg)

[DESIGN]
max-args = 10
max-attributes = 16
max-bool-expr = 5
max-locals = 35
max-module-lines = 1300
max-positional-arguments = 8
max-returns = 8
max-statements = 110

[MESSAGES CONTROL]
disable = raw-checker-failed,
          bad-inline-option,
          locally-disabled,
          file-ignored,
          suppressed-message,
          useless-suppression,
          deprecated-pragma,
          use-symbolic-message-instead,
          use-implicit-booleaness-not-comparison-to-string,
          use-implicit-booleaness-not-comparison-to-zero,
          too-many-public-methods,
          broad-exception-caught,
          duplicate-code,
          line-too-long,
          too-few-public-methods,
          protected-access,
          missing-class-docstring,
          missing-function-docstring,
          import-outside-toplevel,
          redefined-outer-name,
          unnecessary-lambda,
          consider-using-with,
          inconsistent-return-statements,
          consider-using-from-import

[FORMAT]
max-line-length = 88
